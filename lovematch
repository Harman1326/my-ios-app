}


// MARK: - Love Calculator

struct LoveCalculator {
    
    static func clean(_ name: String) -> String {
        name
            .lowercased()
            .filter { $0.isLetter }
    }
    
    static func calculate(boy: String, girl: String) -> Int {
        
        let first = clean(boy)
        let second = clean(girl)
        
        guard !first.isEmpty && !second.isEmpty else {
            return 0
        }
        
        let firstLetters = Set(first)
        let secondLetters = Set(second)
        
        // Common letters
        let common = firstLetters.intersection(secondLetters).count
        
        let totalUnique = firstLetters.union(secondLetters).count
        
        let letterMatch =
            Double(common) / Double(max(totalUnique, 1))
        
        // Name length similarity
        let lengthDifference =
            abs(first.count - second.count)
        
        let lengthScore =
            max(
                0.0,
                1.0 - Double(lengthDifference) / 10.0
            )
        
        // Character values
        let firstValue = first.unicodeScalars.reduce(0) {
            $0 + Int($1.value)
        }
        
        let secondValue = second.unicodeScalars.reduce(0) {
            $0 + Int($1.value)
        }
        
        let combinedValue =
            (firstValue * 3 + secondValue * 7)
        
        let variation =
            combinedValue % 21
        
        // Final formula
        let base =
            (letterMatch * 70) +
            (lengthScore * 30)
        
        var finalScore =
            Int(base) + variation
        
        // Keep result between 1 and 100
        finalScore = max(1, min(finalScore, 100))
        
        return finalScore
    }
    
    static func nameMatch(
        _ boy: String,
        _ girl: String
    ) -> Int {
        
        let first = clean(boy)
        let second = clean(girl)
        
        let a = Set(first)
        let b = Set(second)
        
        let common = a.intersection(b).count
        let total = a.union(b).count
        
        guard total > 0 else {
            return 0
        }
        
        return min(
            100,
            Int((Double(common) / Double(total)) * 100)
        )
    }
    
    static func chemistry(_ score: Int) -> Int {
        let variation = (score * 13 + 17) % 15
        return min(100, max(1, score + variation - 7))
    }
    
    static func message(for score: Int) -> String {
        
        switch score {
        case 90...100:
            return "🔥 Amazing connection! You two are a powerful match."
            
        case 80...89:
            return "❤️ Very strong love compatibility!"
            
        case 70...79:
            return "💕 You two have a beautiful connection."
            
        case 60...69:
            return "✨ There is definitely some cute chemistry."
            
        case 40...59:
            return "😊 Interesting chemistry between you two."
            
        default:
            return "😄 Maybe love needs a little more time!"
        }
    }
}
